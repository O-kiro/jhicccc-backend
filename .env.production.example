# Salin jadi .env di server, lalu isi yang bertanda ISI.
#
#     cp .env.production.example .env
#     docker compose -f compose.prod.yaml run --rm app php artisan key:generate
#
# Jangan pernah commit .env yang sudah terisi.

APP_NAME="MAN Kota Batu"
APP_ENV=production
APP_KEY=                      # ISI: php artisan key:generate
# Jejak galat lengkap tidak boleh tampil ke pengunjung.
APP_DEBUG=false
APP_URL=https://api.jhic2026.rezasidin.my.id   # ISI: alamat publik backend

# Origin portal Next.js yang boleh memanggil /api/* (CORS). Tanpa ini portal
# ditolak browser.
FRONTEND_URLS=https://jhic2026.rezasidin.my.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=warning

# SQLite cukup untuk lomba; berkasnya di database/database.sqlite dan harus
# ikut dicadangkan. Pindah ke MySQL tinggal mengganti empat baris ini.
DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
# Wajib https di produksi supaya cookie sesi panel admin tidak terkirim polos.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Webhook revalidasi situs. Nilainya harus SAMA dengan REVALIDATE_SECRET di
# frontend, dan harus rahasia — jangan pakai nilai dari compose.yaml.
#     openssl rand -hex 32
SITUS_REVALIDATE_URL=https://jhic2026.rezasidin.my.id/api/revalidate
SITUS_REVALIDATE_SECRET=       # ISI: nilai acak
